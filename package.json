{
  "name": "exist-flow",
  "type": "commonjs",
  "version": "0.1.1",
  "description": "Your desktop, one shortcut away.",
  "author": "Exist",
  "license": "MIT",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://127.0.0.1:5713 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5713 electron .\"",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "pack": "electron-builder",
    "pack:dir": "electron-builder --dir",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "tsc --noEmit",
    "test:screenshot": "node scripts/test_screenshot_animation.js",
    "measure:screenshot": "node scripts/measure_screenshot.js",
    "verify:screenshot": "electron scripts/verify_screenshot_display.js",
    "probe:capture": "electron scripts/probe_capture_sources.js",
    "probe:timing": "electron scripts/probe_capture_timing.js",
    "test:tour10": "electron scripts/test_tour10.js",
    "test:cursor": "electron scripts/test_cursor_bug.js",
    "test:screenshot-toggle": "electron scripts/test_screenshot_toggle.js",
    "test:tour17": "electron scripts/test_tour17_item_types.js"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "fuse.js": "^7.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.0",
    "cross-env": "^10.1.0",
    "electron": "^27.3.11",
    "electron-builder": "^24.9.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.exist.flow",
    "productName": "Exist Flow",
    "files": [
      "dist-electron/**/*",
      "dist-renderer/**/*",
      "package.json"
    ],
    "forceCodeSigning": false,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "directories": {
      "output": "release"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerSidebar": "assets/installer/sidebar.bmp",
      "uninstallerSidebar": "assets/installer/sidebar.bmp",
      "installerHeader": "assets/installer/header.bmp",
      "include": "assets/installer/installer.nsh"
    }
  }
}
